{
  // Deploys this repo as a Cloudflare Pages/Workers static site named "hallpass"
  // (no build step, no Worker code). Create the project on first deploy.
  "name": "hallpass",
  "compatibility_date": "2026-07-08",
  "assets": {
    "directory": ".",
    // Multi-page static site, NOT an SPA: serve a real 404 (with 404.html) for
    // missing paths instead of returning index.html with a 200. The old behavior
    // created soft-404s and made Google read sitemap.xml as HTML during deploys.
    "not_found_handling": "404-page",
    // Serve .html URLs directly (200) instead of 308-redirecting them to
    // extension-less URLs. The sitemap + <link rel=canonical> both use the
    // .html form, so the redirect made Google flag them "Page with redirect"
    // (and contradicted the canonical). "none" keeps everything consistent on
    // .html, which also matches the local python http.server used for dev.
    "html_handling": "none"
  }
}
